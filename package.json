{
  "name": "cusesublets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "wrangler dev --ip 127.0.0.1 --port 8917",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "types": "wrangler types",
    "db:local": "wrangler d1 migrations apply DB --local",
    "seed:local": "wrangler d1 execute DB --local --file seeds/demo.sql",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy",
    "preview:demo": "wrangler dev --ip 127.0.0.1 --port 8917 --var APP_ENV:development"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.133.0"
  }
}
